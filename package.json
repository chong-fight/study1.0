{
  "name": "phrase-memory-2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-static-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "audit:data": "node scripts/audit-local-data.mjs",
    "enrich:data": "node scripts/enrich-local-data.mjs",
